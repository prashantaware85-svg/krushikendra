# Copy to `.env.local` for local development.
# The frontend calls the backend via this URL (client + server).
#
# Local development (default):
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production: set the SAME variable as a BUILD-TIME environment variable
# (NEXT_PUBLIC_* values are inlined by `next build`) to the deployed backend,
# e.g. on Render before `next build` runs:
#   NEXT_PUBLIC_API_URL=https://krushikendra-j1sp.onrender.com
# Public URL only — no secrets in frontend env, ever.
