# Copy to `.env` for local backend development.
# NEVER commit `.env` — it is gitignored. Real secrets go only there.
ENVIRONMENT=development
LOG_LEVEL=info
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ── Database (Step 2: PostgreSQL via psycopg, sync engine) ──
# Placeholder values only — replace with real credentials in `.env`.
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/krushi_seva
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_CONNECT_TIMEOUT=5

# ── Auth (Step 3: passwordless mobile-OTP + JWT) ──
# Generate a real secret for any shared/dev environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Production REQUIRES a unique secret >= 32 chars AND AUTH_DEV_OTP_ENABLED=false
# (the app refuses to start otherwise).
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# DEV-ONLY: expose issued OTP as `dev_otp` in send-otp responses (no SMS yet).
# NEVER true in production.
AUTH_DEV_OTP_ENABLED=true

# ── Weather (Step 7: provider abstraction + DB cache) ──
# Provider: "open-meteo" (free, keyless) or "disabled" (no network calls).
# API keys NEVER go in code and NEVER reach the frontend — `.env` only.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com
WEATHER_TIMEOUT_SECONDS=10
WEATHER_CURRENT_TTL_MINUTES=30
WEATHER_FORECAST_TTL_HOURS=6

# ── Market prices (Step 8: provider abstraction + DB cache) ──
# Default "disabled": no live source → API serves labelled DB rows or
# 503 MARKET_DATA_UNAVAILABLE. Keys NEVER in code, NEVER reach frontend.
MARKET_PROVIDER=disabled
MARKET_API_KEY=
MARKET_API_BASE_URL=
MARKET_TIMEOUT_SECONDS=10
MARKET_CACHE_TTL_MINUTES=360

# ── AI / RAG (Step 9: mock-first, keys NEVER in code/frontend/logs) ──
# Providers: "mock" (deterministic dev/test, labelled) or "disabled".
# Production REFUSES mock providers at startup (fail-fast).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mock-model
AI_API_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_MODEL=mock-embed
AI_EMBEDDING_DIM=1536
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.15
RAG_MAX_CONTEXT_CHUNKS=4
RAG_MAX_CONTEXT_CHARS=12000
RAG_CANDIDATE_LIMIT=500
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_MESSAGES_PER_HOUR=30
AI_MAX_HISTORY_MESSAGES=20

# ── Vision / crop image analysis (Step 10: mock-first, keys never exposed)
# Providers: "mock" (deterministic dev/test, labelled) or "disabled".
# Production REFUSES mock vision at startup (fail-fast).
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_MODEL=mock-vision
VISION_API_BASE_URL=
VISION_TIMEOUT_SECONDS=60
VISION_MAX_IMAGES=3
VISION_MAX_FILE_MB=8
VISION_MAX_DIMENSION=4096
VISION_MIN_DIMENSION=200
VISION_MAX_ANALYSES_PER_HOUR=10
VISION_STORAGE_DIR=storage/crop_images

# ── Soil reports (Step 11: reuses vision storage abstraction, separate root)
SOIL_REPORT_MAX_MB=10
SOIL_STORAGE_DIR=storage/soil_reports

# ── Health observation photos (Step 12: same storage reuse, dedicated root)
HEALTH_STORAGE_DIR=storage/health_photos

# ── Store product images (Step 13: same storage reuse, dedicated root)
STORE_STORAGE_DIR=storage/store_images

# ── Store commerce (Step 14: NO payment gateway in this step) ──
# Delivery charge applied at checkout (zero for development); no coupons/GST yet.
ORDER_DELIVERY_CHARGE=0.00
CART_MAX_QTY_PER_ITEM=100
CART_MAX_ITEMS=50

# ── Payments (Step 15: mock-first, keys NEVER in code/frontend/logs) ──
# Providers: "mock" (deterministic dev/test, labelled) or "disabled".
# Production REFUSES mock providers at startup (fail-fast).
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_API_BASE_URL=
PAYMENT_TIMEOUT_SECONDS=10
PAYMENT_WEBHOOK_SECRET=
PAYMENT_ALLOW_UNSIGNED_MOCK_WEBHOOK=false
PAYMENT_MOCK_APPROVE=true
PAYMENT_CURRENCY=INR

# ── Khata ledger (Step 15: immutable entries, balance computed on read) ──
KHATA_ENABLED=true
# Max allowed outstanding in paise (0 = no credit allowed).
KHATA_CREDIT_LIMIT=0
