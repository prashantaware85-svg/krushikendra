# ── Krushi Seva · Root environment template ──────────────────────────────
# Copy to `.env` at repo root for local docker-compose usage.
# Frontend and backend each have their own .env.example as well.
# NEVER commit real `.env` files.

# ── Backend ──
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
API_V1_PREFIX=/api/v1

# CORS: comma-separated origins allowed to call the API (dev default = Next.js)
CORS_ORIGINS=http://localhost:3000

# ── Database (Step 2: PostgreSQL via psycopg) ──
# Placeholder values only — put real credentials in `.env` (gitignored).
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/krushi_seva
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_CONNECT_TIMEOUT=5

# ── Auth (Step 3) — placeholders only, real secrets go in `.env` ──
# Production REQUIRES a unique JWT_SECRET_KEY (>= 32 chars) and
# AUTH_DEV_OTP_ENABLED=false (backend refuses to start otherwise).
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
AUTH_DEV_OTP_ENABLED=true

# ── TEMPORARY APK QA hook (revert after testing!) ──
# OTP_TEST_MODE_ENABLED=true + OTP_TEST_MOBILES=<tester numbers> exposes
# dev_otp in send-otp responses ONLY for those numbers, so the APK tester
# can log in without real SMS. Production default: both unset/false.
# NEVER leave enabled on a production service after QA.
# OTP_TEST_MODE_ENABLED=false
# OTP_TEST_MOBILES=

# ── Weather (Step 7) — placeholders only, real keys go in `.env` ──
# Provider: "open-meteo" (free, keyless) or "disabled". Keys never in code.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com
WEATHER_TIMEOUT_SECONDS=10
WEATHER_CURRENT_TTL_MINUTES=30
WEATHER_FORECAST_TTL_HOURS=6

# ── Market prices (Step 8) — placeholders only, real keys go in `.env` ──
# Default "disabled": labelled DB rows or 503 MARKET_DATA_UNAVAILABLE.
MARKET_PROVIDER=disabled
MARKET_API_KEY=
MARKET_API_BASE_URL=
MARKET_TIMEOUT_SECONDS=10
MARKET_CACHE_TTL_MINUTES=360

# ── AI / RAG (Step 9) — placeholders only, real keys go in `.env` ──
# "mock" (labelled dev) or "disabled"; production refuses mock (fail-fast).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mock-model
AI_API_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_MODEL=mock-embed
AI_EMBEDDING_DIM=1536
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.15
AI_MAX_MESSAGES_PER_HOUR=30

# ── Vision (Step 10) — placeholders only, real keys go in `.env` ──
# "mock" (labelled dev) or "disabled"; production refuses mock (fail-fast).
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_MODEL=mock-vision
VISION_API_BASE_URL=
VISION_TIMEOUT_SECONDS=60
VISION_MAX_IMAGES=3
VISION_MAX_FILE_MB=8
VISION_MAX_ANALYSES_PER_HOUR=10
VISION_STORAGE_DIR=storage/crop_images

# ── Soil reports (Step 11: reuses vision storage abstraction, separate root)
SOIL_REPORT_MAX_MB=10
SOIL_STORAGE_DIR=storage/soil_reports

# ── Health observation photos (Step 12: same storage reuse, dedicated root)
HEALTH_STORAGE_DIR=storage/health_photos

# ── Store product images (Step 13: same storage reuse, dedicated root)
STORE_STORAGE_DIR=storage/store_images

# ── Store commerce (Step 14: NO payment gateway in this step) ──
ORDER_DELIVERY_CHARGE=0.00
CART_MAX_QTY_PER_ITEM=100
CART_MAX_ITEMS=50

# ── Redis (future: caching / background jobs, not used in Step 1) ──
REDIS_URL=redis://localhost:6379/0

# ── Frontend ──
# Public URL of the backend API, consumed by Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
